# Enterprise Knowledge Search — Environment Config
# Copy to .env and edit

# ── Backend selection ──
EMBEDDING_BACKEND=local             # stub | local | jina_api

# ── Local model ──
LOCAL_MODEL_ID=all-MiniLM-L6-v2    # dev default (384-dim, fast)
# LOCAL_MODEL_ID=jinaai/jina-embeddings-v5-omni-small  # production

# ── Jina API (only needed if EMBEDDING_BACKEND=jina_api) ──
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v5-omni-small
JINA_TASK=retrieval.passage
JINA_DIMENSIONS=512

# ── Embedding ──
EMBED_DIM=384                       # Matryoshka truncation target
TASK_ADAPTER=retrieval

# ── Chroma ──
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=multimodal-knowledge

# ── Ingestion ──
INGEST_BATCH_SIZE=32
INGEST_MAX_RETRIES=3

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
