# Copy to .env and fill in values
DIAGNOSIS_LLM_PROVIDER=anthropic       # anthropic | ollama
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (if DIAGNOSIS_LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# SimpleMem (set to false after cloning aiming-lab/SimpleMem)
SIMPLEMEM_USE_STUB=true

# Ports
EVOLVEMEM_API_PORT=8001
EVOLVEMEM_DASH_PORT=8000
