[Unit]
Description=EvolveMem TicketMind API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/arxiv_impl/evolvemem-2605.13941
EnvironmentFile=-%h/arxiv_impl/evolvemem-2605.13941/.env
ExecStart=%h/.local/bin/uvicorn api:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5s
StandardOutput=append:%h/arxiv_impl/evolvemem-2605.13941/logs/evolvemem.log
StandardError=append:%h/arxiv_impl/evolvemem-2605.13941/logs/evolvemem.log

[Install]
WantedBy=default.target
